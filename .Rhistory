polyroot(c(1,1)) # x + 1 = 0の解
polyroot(c(1, 2, 1)) # x^2 + 2x + 1 = 0の解
polyroot(c(1, 3, 3, 1)) # x^3 + 3x^2 + 3x + 1 = 0の解
polyroot(c(1, -3, -3, -1)) # 虚数解があるとき
Mod(polyroot(c(1, -3, -3, -1)) ) # 原点からの距離に変換
polyroot(c(1,1)) # x + 1 = 0の解
polyroot(c(1, 2, 1)) # x^2 + 2x + 1 = 0の解
polyroot(c(1, 3, 3, 1)) # x^3 + 3x^2 + 3x + 1 = 0の解
polyroot(c(1, -3, -3, -1)) # 虚数解があるとき
Mod(polyroot(c(1, -3, -3, -1)) ) # 原点からの距離に変換
