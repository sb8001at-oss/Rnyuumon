pacman::p_load(AIPW, SuperLearner)
data("eager_sim_obs")
data.frame(
"列名" = colnames(eager_sim_obs),
"列の意味" = c(
"シミュレートしたアウトカム",
"シミュレートした割付群",
"eligibility（おそらく被験者としての適格性）",
"以前の流産の回数",
"年齢",
"妊活の年数",
"BMI",
"血圧"
)
) |> knitr::kable(caption="eager_sim_obsの各列について")
pacman::p_load(AIPW, SuperLearner)
data("eager_sim_obs")
outcome <- eager_sim_obs$sim_Y # 目的変数
exposure <- eager_sim_obs$sim_A # 割付群
covariates <- as.matrix(eager_sim_obs[-1:-2]) # その他の共変量
AIPW_SL <-
AIPW$new(
Y = outcome,
A = exposure,
W = covariates,
Q.SL.library = c("SL.mean","SL.glm"),
g.SL.library = c("SL.mean","SL.glm"),
k_split = 3,
verbose = FALSE
)
AIPW_SL$fit()
AIPW_SL$
summary(g.bound = 0.025) # g.boundのデフォルト値は0.025
AIPW_SL$result
