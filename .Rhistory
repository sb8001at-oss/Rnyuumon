histogramUI <- function(id){
tagList(
sliderInput(NS(id, "bins"),"Number of bins:", min = 1, max = 50, value = 30),
plotOutput(NS(id, "hist"))
)
}
histogramServer <- function(id, x) {
moduleServer(
id,
function(input, output, session) {
bins <- reactive(input$bins)
hist(x, breaks = bins())
}
)
}
testServer(histogramServer)
library(shiny)
histogramUI <- function(id){
tagList(
sliderInput(NS(id, "bins"),"Number of bins:", min = 1, max = 50, value = 30),
plotOutput(NS(id, "hist"))
)
}
histogramServer <- function(id, x) {
moduleServer(
id,
function(input, output, session) {
bins <- reactive(input$bins)
hist(x, breaks = bins())
}
)
}
testServer(histogramServer)
histogramApp <- function() {
x <- faithful[, 2]
ui <- fluidPage(
histogramUI("hist1")
)
server <- function(input, output, session) {
histogramServer("hist1", x)
}
shinyApp(ui, server)
}
histogramApp()
