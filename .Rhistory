# リストの作成（=の左が名前（names）、右が要素）
lst <- list(x = c(1, 2, 3, 4), y = "dog", z = c(T, F, T, T, F))
attach(lst)
x
y
z
# データフレームやリストを引数に取る
attach(iris)
# 列名で要素を呼び出せる
Sepal.Length
detach(iris)
head(Sepal.Length)
detach(lst)
?rm
pi <- 3 # piに3を代入する
pi # piは3になってしまう
rm(pi)
pi # 正しい値に戻る
unlink("./tmp/test", recursive = T)
