library(mixexp)
SCD(5) |> head() # 5説明変数の実験（各説明変数6段階）
Xvert(nfac = 5, lc = c(0.9, 0.03, 0.02. 0.04, 0.01), uc = c(1.0, 0.1, 0.1, 0.1, 0.1))
Xvert(nfac = 5, lc = c(0.9, 0.03, 0.02, 0.04, 0.01), uc = c(1.0, 0.1, 0.1, 0.1, 0.1))
Xvert(nfac = 5, lc = c(0.9, 0.03, 0.02, 0.04, 0.01), uc = c(1.0, 0.1, 0.1, 0.1, 0.1), ndm = 1)
Xvert(nfac = 5, lc = c(0.8, 0.03, 0.02, 0.04, 0.01), uc = c(0.9, 0.1, 0.1, 0.1, 0.1), ndm = 1)
Xvert(nfac = 5, lc = c(0.8, 0.03, 0.02, 0.04, 0.01), uc = c(0.9, 0.1, 0.1, 0.1, 0.1), ndm = 2)
Xvert(nfac = 5, lc = c(0.8, 0.03, 0.02, 0.04, 0.01), uc = c(0.9, 0.1, 0.1, 0.1, 0.1), ndm = 0)
# 5つの説明変数をlcからucの間で調整する
Xvert(nfac = 5, lc = c(0.8, 0.03, 0.02, 0.04, 0.01), uc = c(0.9, 0.1, 0.1, 0.1, 0.1), ndm = 0, plot=TRUE)
# 3つの説明変数を調整する
Xvert(nfac = 5, lc = c(0.5, 0.4, 0.1), uc = c(0.9, 0.5, 0.3), ndm = 0)
# 3つの説明変数を調整する
Xvert(nfac = 5, lc = c(0.5, 0.4, 0.1), uc = c(0.9, 0.5, 0.2), ndm = 0)
# 3つの説明変数を調整する
Xvert(nfac = 5, lc = c(0.3, 0.3, 0.05), uc = c(0.9, 0.5, 0.2), ndm = 0)
# 3つの説明変数を調整する
Xvert(nfac = 5, lc = c(0.3, 0.3, 0.05), uc = c(0.9, 0.5, 0.2))
Xvert(nfac = 5, lc = c(0.3, 0.3, 0.05), uc = c(0.9, 0.5, 0.2)) |> rowsum()
Xvert(nfac = 5, lc = c(0.3, 0.3, 0.05), uc = c(0.9, 0.5, 0.2)) |> rowSums()
