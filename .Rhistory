# 以下の3つが並列演算される部分
a <- future(f(1))
b <- future(f(2))
c <- future(f(3))
value(a)
value(b)
value(c)
toc()
plan(multisession)
tic()
a <- future(f(1))
b <- future(f(2))
c <- future(f(3))
value(a)
value(b)
value(c)
toc()
plan(multisession, workers = 3)
a <- future({x <- 1; x * 10})
a %<-% {f(1)}
b %<-% {f(2)}
c %<-% {f(3)}
a
b
c
a %<-% {f2(1)}
b %<-% {f2(2)}
c %<-% {f2(3)}
a
b
c
reset <- FALSE
x <- 1
y %<-% {if (reset) x <- 0; x + 1 }
y
reset <- FALSE
x <- 1
y %<-% { x; if (reset) x <- 0; x + 1 }
y
?future
pacman::p_load(future.apply, furrr, doFuture)
toBibtex(citation(future_apply))
toBibtex(citation("future_apply"))
toBibtex(citation("future.apply"))
toBibtex(citation("furrr"))
toBibtex(citation("doFuture"))
foreach(i = 1:3) %do% {f(i)}
