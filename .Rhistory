d <- data.frame(
operator = c("==", "!=", "<", "<=", ">", ">="),
meaning = c("等しい", "等しくない", "小なり", "小なりイコール", "大なり", "大なりイコール")
)
colnames(d) <- c("比較演算子", "比較演算子の意味")
knitr::kable(d, caption="表3：Rで使える比較演算子")
# 線形混合モデルのデータ
pacman::p_load(lmerTest)
library(tidyverse)
l_model <- lm(Reaction ~ Days, data = sleepstudy)
ri_model <- lmer(Reaction ~ Days + (1 | Subject), data = sleepstudy)
rs_model <- lmer(Reaction ~ Days + (Days | Subject), sleepstudy)
l_model
ri_model
rs_model
?predict.lm
seq(1, 9, by = 0.1)
pred_d <- data.frame(x=seq(1, 9, by = 0.1))
predict(l_model, pred_d)
pred_d <- data.frame(Days=seq(1, 9, by = 0.1))
predict(l_model, pred_d)
predict(l_model, pred_d, interval = "confidence")
predict(ri_model, pred_d, interval = "confidence")
?lmer
predict(ri_model)
predict(ri_model, se.fit=TRUE)
data.frame(Days = sleepstudy$Days, predict(ri_model, se.fit=TRUE)
)
library(lmerTest)
library(tidyverse)
l_model <- lm(Reaction ~ Days, data = sleepstudy)
ri_model <- lmer(Reaction ~ Days + (1 | Subject), data = sleepstudy)
rs_model <- lmer(Reaction ~ Days + (Days | Subject), data = sleepstudy)
pred_d <- data.frame(Days=seq(1, 9, by = 0.1))
pred_l_model <- predict(l_model, pred_d, interval = "confidence")
pred_ri_model <- data.frame(Days = sleepstudy$Days, predict(ri_model, se.fit=TRUE))
pred_ri_model
pred_ri_model |> ggplot(aes(x=Days, y=fit, ymax=fit+se.fit, ymin=fit-se.fit))+
geom_line()+
geom_ribbon()
pred_ri_model <- data.frame(Days = sleepstudy$Days, predict(ri_model, se.fit=TRUE, re.form=NULL))
pred_ri_model |> ggplot(aes(x=Days, y=fit, ymax=fit+se.fit, ymin=fit-se.fit))+
geom_line()+
geom_ribbon()
pred_ri_model <- data.frame(Days = sleepstudy$Days, predict(ri_model, se.fit=TRUE, re.form=NA))
pred_ri_model |> ggplot(aes(x=Days, y=fit, ymax=fit+se.fit, ymin=fit-se.fit))+
geom_line()+
geom_ribbon()
pred_l_model <- predict(l_model, pred_d, interval = "confidence")
pred_ri_model <- data.frame(Days = sleepstudy$Days, predict(ri_model, se.fit=TRUE, re.form=NA))
pred_rs_model <- data.frame(Days = sleepstudy$Days, predict(rs_model, se.fit=TRUE, re.form=NA))
pred_l_model
pred_l_model <- data.frame(Days=seq(1, 9, by = 0.1), predict(l_model, pred_d, interval = "confidence"))
pred_l_model
ggplot()+
geom_ribbon(aes(x=Days, y=fit, ymax=upr, ymin=lwr, color="red", fill="red", alpha = 0.3))
ggplot()+
geom_ribbon(aes(x=Days, y=fit, ymax=upr, ymin=lwr, color="red", fill="red", alpha = 0.3), data = pred_l_model)
pred_ri_model
pred_ri_model <- data.frame(Days = sleepstudy$Days, predict(ri_model, se.fit = TRUE, re.form = NA))
pred_rs_model <- data.frame(Days = sleepstudy$Days, predict(rs_model, se.fit = TRUE, re.form = NA))
ggplot()+
geom_ribbon(aes(x=Days, y=fit, ymax=upr, ymin=lwr, color="red", fill="red", alpha = 0.3), data = pred_l_model)+
geom_ribbon(aes(x=Days, y=fit, ymax=fit+se.fit, ymin=fit-se.fit, color="blue", fill="blue", alpha = 0.3), data = pred_ri_model)
ggplot()+
geom_ribbon(aes(x=Days, y=fit, ymax=upr, ymin=lwr, color="red", fill="red", alpha = 0.3), data = pred_l_model)+
geom_ribbon(aes(x=Days, y=fit, ymax=fit+se.fit, ymin=fit-se.fit, color="blue", fill="blue", alpha = 0.3), data = pred_ri_model)+
geom_ribbon(aes(x=Days, y=fit, ymax=fit+se.fit, ymin=fit-se.fit, color="purple", fill="purple", alpha = 0.3), data = pred_rs_model)
ggplot()+
geom_ribbon(aes(x=Days, y=fit, ymax=upr, ymin=lwr, color="red", fill="red", alpha = 0.1), data = pred_l_model)+
geom_ribbon(aes(x=Days, y=fit, ymax=fit+se.fit, ymin=fit-se.fit, color="blue", fill="blue", alpha = 0.1), data = pred_ri_model)+
geom_ribbon(aes(x=Days, y=fit, ymax=fit+se.fit, ymin=fit-se.fit, color="purple", fill="purple", alpha = 0.1), data = pred_rs_model)
ggplot()+
geom_ribbon(aes(x=Days, y=fit, ymax=upr, ymin=lwr, color=NULL, fill="red", alpha = 0.1), data = pred_l_model)+
geom_ribbon(aes(x=Days, y=fit, ymax=fit+se.fit, ymin=fit-se.fit, color=NULL, fill="blue", alpha = 0.1), data = pred_ri_model)+
geom_ribbon(aes(x=Days, y=fit, ymax=fit+se.fit, ymin=fit-se.fit, color=NULL, fill="purple", alpha = 0.1), data = pred_rs_model)
predict(ri_model, newparams = seq(1, 9, by = 0.1),se.fit = TRUE, re.form = NA)
# 線形混合モデルのデータ
pacman::p_load(lmerTest)
data("sleepstudy", package = "lme4")
head(sleepstudy)
# DaysとReactionの関係を調べる
ggplot(sleepstudy, aes(x = Days, y = Reaction, color = Subject, alpha = 0.5)) +
geom_point(size = 2) +
theme(legend.position = "none") +
geom_line()
library(tidyverse)
# 線形混合モデルのデータ
pacman::p_load(lmerTest)
data("sleepstudy", package = "lme4")
head(sleepstudy)
# DaysとReactionの関係を調べる
ggplot(sleepstudy, aes(x = Days, y = Reaction, color = Subject, alpha = 0.5)) +
geom_point(size = 2) +
theme(legend.position = "none") +
geom_line()
lmer_sleepstudy <- lmer(Reaction ~ Days + (1 | Subject), data = sleepstudy)
lmer_sleepstudy %>% summary()
lmer(Reaction ~ Days + (Days | Subject), sleepstudy) %>% summary()
lm(Reaction ~ Days, data = sleepstudy) # 線形モデル
lmer(Reaction ~ Days + (1 | Subject), data = sleepstudy) # ランダム切片モデル
lmer(Reaction ~ Days + (Days | Subject), sleepstudy) %>% summary() # ランダム傾きモデル
result_lmer <- lmer(Reaction ~ Days + (Days | Subject), sleepstudy)
result_lmer@sigma # 残差の標準偏差
anova(result_lmer, type = "I") # type Iの分散分析結果
coef(result_lmer) # 個々の被験者の傾きと切片
?merMod
fitted(lmer(Reaction ~ Days + (Days | Subject), sleepstudy))
coef(lmer(Reaction ~ Days + (Days | Subject), sleepstudy). type ="fixed")
coef(lmer(Reaction ~ Days + (Days | Subject), sleepstudy), type ="fixed")
coef(lmer(Reaction ~ Days + (Days | Subject), sleepstudy), fixed.only = TRUE)
lm_sleepstudy <- lm(Reaction ~ Days, data = sleepstudy) # 線形モデル
llm_ri_sleepstudy <- lmer(Reaction ~ Days + (1 | Subject), data = sleepstudy) # ランダム切片モデル
llm_rs_sleepstudy <- lmer(Reaction ~ Days + (Days | Subject), sleepstudy) # ランダム傾きモデル
llm_ri_sleepstudy
str(llm_ri_sleepstudy)
llm_rs_sleepstudy@beta
coef(lm_sleepstudy)
llm_ri_sleepstudy@beta
llm_rs_sleepstudy@beta
lm_sleepstudy$coefficients
llm_ri_sleepstudy@beta
llm_rs_sleepstudy@beta
