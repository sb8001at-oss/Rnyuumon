change_all_properties := new_generic("x")
method(change_all_properties, MyDog) <- function(x, name, age, trick){
# propertiesを変更する際にはpropsを用いた方がよい場合もある
props(x) <-
list(
name = name,
age = age,
trick = trick
)
x
}
Pochi <- MyDog("Pochi", 10, "sit")
change_all_properties(Pochi, "Kuro", 12, "hand")
