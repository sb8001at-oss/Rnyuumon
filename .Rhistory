datf <- data.frame(
from = c("A", "B", "C"),
to = c("B", "C", "A")
)
graph_from_data_frame(datf)
# edgeのデータフレームに列を追加する（weightは特性）
d_edge$weight <- c(1, 2, 3)
d_edge <- data.frame(
from = c("A", "B", "C"),
to = c("B", "C", "A")
)
graph_from_data_frame(d_edge)
# edgeのデータフレームに列を追加する（weightは特性）
d_edge$weight <- c(1, 2, 3)
# vertexのデータフレーム（age、sexは特性）
d_vertex <- data.frame(
name = c("A", "B", "C"),
age = c(20, 25, 30),
sex = c("F", "M", "F")
)
g <- graph_from_data_frame(d_edge, vertices = d_vertex)
