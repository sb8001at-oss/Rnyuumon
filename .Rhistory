f <- function(x){x + 1} # f(x) = x + 1の関数
uniroot(f, c(-2, 2)) # -2 ~ 2の間で1点で交わる
uniroot(f, c(2, 4))
polyroot(c(1, 2, -1))
uniroot(f2, c(-1, 0))
f2 <- function(x){x ^ 2 + 2 * x - 1} # f(x) = x^2 + 2x + 1の関数
polyroot(c(1, 2, -1)) # f2 = 0は-0.41、2.41に解をもつ
uniroot(f2, c(-1, 0))
uniroot(f2, c(-2, 3))
uniroot(f2, c(-1, 0))
polyroot(c(1, 2, -1)) # f2 = 0は-0.41、2.41に解をもつ
f(-0.41)
polyroot(c(-1, 2, 1)) # f2 = 0は-0.41、2.41に解をもつ
uniroot(f2, c(-1, 0))
uniroot(f2, c(-2, 3))
f(-0.41)
f(0.41)
plot(x=seq(-10, 10, by=0.01), y=f2(seq(-10, 10, by = 0.01)))
f(0.4)
f(0.3)
f(0.1)
f(-4)
f(-2)
f(-1.5)
f(-1.1)
polyroot
