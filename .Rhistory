y = iris$Sepal.Width,
cex = iris$Petal.Length/4
)
plot(
x = iris$Sepal.Length,
y = iris$Sepal.Width,
cex = iris$Petal.Length/3
)
plot(iris$Sepal.Length, iris$Sepal.Width)
