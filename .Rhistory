split(x, "y") |> head(5)
split(x, "band") |> head(5)
# circleはPOLIGONのsfcオブジェクト
circle = st_sfc(st_buffer(st_point(c(293749.5, 9115745)), 400), crs = st_crs(x))
# sfcで呼び出すと切り出し（crop）ができる
plot(x[circle][, , , 1], reset = FALSE) # x[circle]でsfでのcropを行っている
par(new = T)
