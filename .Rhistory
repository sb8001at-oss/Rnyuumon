iris6 <- head(iris) # 始めの6行を選択
# Sepal.Lengthの列とSepal.Widthの列の値を掛ける
with(iris6, Sepal.Length * Sepal.Width)
# Sepal.Lengthの列とSepal.Widthの列の値を掛けて、値を列として登録する
within(iris6, Sepal_multiple <- Sepal.Length * Sepal.Width)
