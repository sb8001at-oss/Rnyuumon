example("plot")
plot(x = Sepal.Length, y = Sepal.Width, color= ifelse(iris$Species == "versicolor", "red", "blue"), data = iris)
plot(x = iris$Sepal.Length, y = iris$Sepal.Width, color= ifelse(iris$Species == "versicolor", "red", "blue"))
plot(
x = iris$Sepal.Length,
y = iris$Sepal.Width,
col= ifelse(iris$Species == "versicolor", "red", "blue"))
plot(
x = iris$Sepal.Length,
y = iris$Sepal.Width,
col = ifelse(iris$Species == "versicolor", "red", "blue"),
pch = ifelse(iris$Species == "setosa", 1, 2))
plot(
x = iris$Sepal.Length,
y = iris$Sepal.Width,
col = ifelse(iris$Species == "versicolor", "red", "blue"),
pch = ifelse(iris$Species == "setosa", 1, 2),
bg = ifelse(iris$Sepal.Width > (iris$Sepal.Length - 2), "lightcyan", "mistyrose")
)
plot(
x = iris$Sepal.Length,
y = iris$Sepal.Width,
col = ifelse(iris$Species == "versicolor", "red", "blue"),
pch = ifelse(iris$Species == "setosa", 1, 2),
cex = ifelse(iris$Sepal.Width > (iris$Sepal.Length - 2), 1, 2)
)
plot(
x = iris$Sepal.Length,
y = iris$Sepal.Width,
col = ifelse(iris$Species == "versicolor", "red", "blue"),
pch = ifelse(iris$Species == "setosa", 1, 2),
cex = ifelse(iris$Sepal.Width > (iris$Sepal.Length - 2), 1, 0.5)
)
plot(
x = iris$Sepal.Length,
y = iris$Sepal.Width,
col = ifelse(iris$Species == "versicolor", "red", "blue"),
pch = ifelse(iris$Species == "setosa", 1, 2),
cex = ifelse(iris$Sepal.Width > (iris$Sepal.Length - 2), 1.5, 1)
)
plot(
x = iris$Sepal.Length,
y = iris$Sepal.Width,
col = ifelse(iris$Species == "versicolor", "red", "blue"),
pch = ifelse(iris$Species == "setosa", 1, 2),
cex = ifelse(iris$Sepal.Width > (iris$Sepal.Length - 2.5), 1.5, 1)
)
plot(
