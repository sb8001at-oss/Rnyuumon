library(stringr)
f2 <- function(x){
str_c(x, ", ", Sys.time())
}
lapply(1:3, f2)
cl <- makeCluster(3)
parLapply(cl, 1:3, f2)
clusterEvalQ(cl, library(stringr))
parLapply(cl, 1:3, f2)
y <- 2
f3 <- function(x){
x + y
}
parLapply(cl, 1:3, f3)
clusterEvalQ(cl, y <- 2)
parLapply(cl, 1:3, f3)
clusterExport(cl, "y")
parLapply(cl, 1:3, f3)
stopCluster(cl)
pacman::p_load(foreach, doParallel)
foreach(i = 1:3) %do% {f(1)}
lapply(1:3, f)
# for(i in 1:2) for(j in 1:2){print(paste("i=", i, "j=", j, "i+J=", i + j))}と同じだが、
# 返り値がリストであるところが異なる
foreach(i = 1:2) %:% foreach(j = 1:2) %do% {paste("i=", i, "j=", j, "i+J=", i + j)}
tic()
foreach(i = 1:3) %do% {f(1)}
toc()
foreach(i = 1:3, .combine = c) %do% {f(1)}
foreach(i = 1:3, .combine = rbind) %do% {\(x){c(x, 1)}}
foreach(i = 1:3, .combine = cbind) %do% {\(x){c(x, 1)}}
foreach(i = 1:3, .combine = cbind) %do% {\(x){c(x)}}
foreach(i = 1:3, .combine = cbind) %do% {f(1)}
stopCluster(cl)
