set.seed(0)
data <- NULL
for(j in 1:10000){
mat <- matrix(nrow=100, ncol=5)
for(i in 2:100){
v <- rnorm(i)
msdv <- (sum(((v - mean(v)) ^ 2)) / i) ^ 0.5
sdv <- sd(v)
sev <- sd(v) / i ^ 0.5
conf_int <- t.test(v) |> _$conf.int |> _[2]
mat[i,] <- c(i, msdv, sdv, sev, conf_int)
}
data <- rbind(data, mat)
}
set.seed(0)
data <- NULL
for(j in 1:2000){
mat <- matrix(nrow=100, ncol=5)
for(i in 2:100){
v <- rnorm(i)
msdv <- (sum(((v - mean(v)) ^ 2)) / i) ^ 0.5
sdv <- sd(v)
sev <- sd(v) / i ^ 0.5
conf_int <- t.test(v) |> _$conf.int |> _[2]
mat[i,] <- c(i, msdv, sdv, sev, conf_int)
}
data <- rbind(data, mat)
}
data <- as.data.frame(data)
colnames(data) <- c("n","population_SD", "sample_SD", "SE", "confidence_interval")
