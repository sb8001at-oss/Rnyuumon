x <- rep(1:5, 5)
x
unique(x)
x <- 1:10
y <- 7:16
union(x, y) # xとyの和集合
intersect(x, y) # xとyの積集合
setdiff(x, y) # xにあってyに無いもの
setdiff(y, x) # yにあってxに無いもの
setequal(x, y) # xとyが同一かどうかを評価
setequal(x, 10:1) # 要素が同一なのでTRUE
x %in% y # xのうち、yにあるものはTRUE
duplicated(c(1, 2, 3, 4, 4)) # 4が重複しているのでTRUE、それ以外はFALSE
anyDuplicated(c(1, 2, 3, 4, 4)) # 重複があるのでTRUE
anyDuplicated(unique(c(1, 2, 3, 4, 4))) # 重複がないとFALSE
anyDuplicated(c(1, 2, 3, 4, 4, 4)) # 重複があるのでTRUE
x <- rep(1:5, 5)
x
unique(x)
x <- 1:10
y <- 7:16
union(x, y) # xとyの和集合
intersect(x, y) # xとyの積集合
setdiff(x, y) # xにあってyに無いもの
setdiff(y, x) # yにあってxに無いもの
setequal(x, y) # xとyが同一かどうかを評価
setequal(x, 10:1) # 要素が同一なのでTRUE
x %in% y # xのうち、yにあるものはTRUE
duplicated(c(1, 2, 3, 4, 4)) # 4が重複しているのでTRUE、それ以外はFALSE
anyDuplicated(c(1, 2, 3, 4, 4, 4)) # 5番目の要素で重複があるので5を返す
anyDuplicated(unique(c(1, 2, 3, 4, 4))) # 重複がないので0が返ってくる
duplicated(c(1, 2, 3, 4, 4, 4)) # 4が5番目から重複しているのでTRUE、それ以外はFALSE
