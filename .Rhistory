)
Pochi <- MyDog$new("Pochi", 10, "sit")
Pochi$push_trick("hand") # エラー
# missing(trick)がTRUEの場合
Pochi$push_trick
# missing(trick)がFALSEの場合（代入した値が引数として取り扱われる）
Pochi$push_trick <- "lefthand"
Pochi$trick
BDMyDog <-
R6Class(
"BDMyDog",
inherit = MyDog,
public =
list(
birthday = NULL,
initialize = function(name, age, trick, birthday){
self$name <- name
self$age <- age
self$trick <- trick
self$birthday <- birthday
},
cgbd_trick = function(birthday, trick){
# 親クラスのメンバーはsuperで呼び出す
self$birthday <- birthday
super$push_trick <- trick
}
)
)
Pochi <- BDMyDog$new("Pochi", 10, "sit", "2016/6/3")
Pochi
# 親クラスのメソッドを利用
Pochi$push_trick <- "hand"
Pochi$trick
Pochi$cgbd_trick("2020/6/3", "lefthand")
Pochi
# Pochi$ageは10
Pochi$age
# PochiをコピーしてKuroに代入
Kuro <- Pochi
# Kuroのageを15に変更
Kuro$age <- 15
# Pochiのageも15になる
Kuro$age
Pochi$age
# Pochi$ageは10
Pochi$age
# cloneメソッドを用いる
Kuro <- Pochi$clone()
# Kuroのageを15に変更
Kuro$age <- 15
# Pochi$ageは10のまま
Kuro$age
Pochi$age
# Pochi$ageは10
Pochi$age <- 10
# Pochi$ageは10
Pochi$age <- 10
# cloneメソッドを用いる
Kuro <- Pochi$clone()
# Kuroのageを15に変更
Kuro$age <- 15
# Pochi$ageは10のまま
Kuro$age
Pochi$age
pacman::p_load(S7)
MyDog <-
new_class(
"MyDog",
properties =
list(
name = class_character,
age = class_numeric,
trick = class_character
),
validator = function(self){
# NULLが返ってくるとエラーなし，返り値があるとエラーが出る
if(length(self@name) != 1){
"2つ以上の名前を付けることはできません"
} else if (length(self@age) != 1){
"2つ以上の年齢を付けることはできません"
} else if (self@age < 0 | self@age > 20){
"年齢は0歳以上20歳未満として下さい"
}
}
)
MyDog
MyDog("Pochi", 10, "sit")
MyDog("Pochi", 100, "sit")
Pochi <- MyDog("Pochi", 10, "sit")
Pochi@age
Pochi@age <- 15
Pochi
Pochi@age <- 25
Pochi@name <- c("Pochi", "Kuro")
Pochi@age <- "10"
class(Pochi)
sloop::otype(Pochi)
# UseMethodと同じようなものが必要
add_trick <- new_generic("add_trick", "x")
method(add_trick, MyDog) <- function(x, trick){
x@trick <- c(x@trick, trick)
x
}
Pochi <- add_trick(Pochi, "hand")
add_trick
S7_data(add_trick)
method(add_trick, MyDog)
paste_trick <- new_generic("paste_trick", "x", function(x, ..., collapse=" "){
S7_dispatch()
})
