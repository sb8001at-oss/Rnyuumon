coxph(Surv(time, status) ~ sex + age + ph.ecog + ph.karno, data = cancer |> na.omit())
result_step <- step(model_All_coxph, trace = 0)
result_step
# マルチンゲール残差
result_km2_cox |> residuals(type="martingale") |> head()
# シェーンフェルド残差
result_km2_cox |> residuals(type="schoenfeld") |> head()
