Sys.time() |> class()
?system.time
t <- Sys.time() # 現在時刻を記録
Sys.sleep(3) # 3秒スリープ
Sys.time() - t # 現在時刻と記録した時刻の差を計算
# system.time関数でも演算時間を計測できる
system.time(for(i in 1:1000000){mean(1:i)})
