`目的変数の分布` = c("二項分布", "正規分布", "ガンマ分布", "逆ガウス分布", "ポアソン分布", "疑似二項分布", "疑似ポアソン分布"),
`リンク関数` = c("logit", "identity", "inverse", "1/mu^{2}", "log", "logit", "log"),
