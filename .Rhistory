MyDog <-
R6Class(
"MyDog",
public =
list(
name = NA,
age = NA,
trick = NA,
validate = function(){
stopifnot(is.character(self$name))
stopifnot(length(self$name) == 1)
stopifnot(is.numeric(self$age))
stopifnot(length(self$age) == 1)
stopifnot(is.character(self$trick))
},
initialize = function(name, age, trick){
self$name = name
self$age = age
self$trick = trick
self$validate()
}
)
)
MyDog$new("Pochi", "10", "sit")
MyDog <-
R6Class(
"MyDog",
# これがpublicのメンバー
public =
list(
name = NA,
add_age = function(){
private$age <- private$age + 1
invisible(self)
},
initialize = function(name, age, trick){
self$name <- name
private$age <- age
private$trick <- trick
},
show_age = function(){
private$age
}
),
# こちらがprivateのメンバー
private =
list(
age = NA,
trick = NA
)
)
Pochi <- MyDog$new("Pochi", 10, "sit")
# $ を用いた呼び出しや代入はできない
Pochi$age
Pochi$age <- 15
# クラスのメソッドを用いれば、メンバーにアクセスできる
Pochi$show_age()
Pochi$add_age()
Pochi$show_age()
MyDog <-
R6Class(
"MyDog",
public =
list(
name = NA,
age = NA,
trick = NA,
initialize = function(name, age, trick){
self$name <- name
self$age <- age
self$trick <- trick
}
),
active =
list(
push_trick = function(trick){
if(missing(trick)){return(self$trick)}
self$trick <- c(self$trick, trick)
invisible(self)
}
)
)
Pochi <- MyDog$new("Pochi", 10, "sit")
Pochi$push_trick("hand") # エラー
# missing(trick)がTRUEの場合
Pochi$push_trick
# missing(trick)がFALSEの場合（代入した値が引数として取り扱われる）
Pochi$push_trick <- "lefthand"
Pochi$trick
BDMyDog <-
R6Class(
"BDMyDog",
inherit = MyDog,
public =
list(
birthday = NA,
initialize = function(name, age, trick, birthday){
self$name <- name
self$age <- age
self$trick <- trick
self$birthday <- birthday
},
cgbd_trick = function(birthday, trick){
self$birthday <- birthday
super$push_trick <- trick
}
)
)
Pochi <- BDMyDog$new("Pochi", 10, "sit", "2016/6/3")
Pochi
Pochi$push_trick <- "hand"
Pochi$trick
Pochi$cgbd_trick("2020/6/3", "lefthand")
Pochi
Pochi$age
Kuro <- Pochi
Kuro$age <- 15
Kuro$age
Pochi$age
Pochi$age
Kuro <- Pochi$clone()
Kuro$age <- 5
Kuro$age
Pochi$age
